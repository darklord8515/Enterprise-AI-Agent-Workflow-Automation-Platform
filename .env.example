# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env. All values below are placeholders.
# ---------------------------------------------------------------------------

# "mock" runs fully offline with deterministic providers; "azure" uses real Azure services.
PROVIDER_MODE=mock
LOG_LEVEL=INFO
DATA_DIR=./data

# API authentication: comma-separated key:principal pairs. Empty disables auth (local dev only).
# Generate keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# Workflow tuning
MAX_REVISIONS=1
RETRIEVAL_TOP_K=5
RETRIEVAL_MODE=hybrid          # hybrid | vector | keyword
MAX_UPLOAD_BYTES=5242880
ALLOWED_EXTENSIONS=.txt,.md,.pdf

# --- Azure OpenAI (required when PROVIDER_MODE=azure) ------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# Leave empty to authenticate with Entra ID (DefaultAzureCredential / az login / managed identity).
AZURE_OPENAI_API_KEY=
# Leave empty to use the GA v1 endpoint (<endpoint>/openai/v1/), which needs no api-version.
AZURE_OPENAI_API_VERSION=
# Recommended model: gpt-5.4-mini (reasoning model: keep AZURE_OPENAI_TEMPERATURE empty)
AZURE_OPENAI_CHAT_DEPLOYMENT=<chat-deployment-name>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<embedding-deployment-name>
# Must match the embedding model and the search index (text-embedding-3-small: up to 1536).
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536
# Leave empty for reasoning models that reject temperature.
AZURE_OPENAI_TEMPERATURE=
AZURE_OPENAI_TIMEOUT_SECONDS=60
AZURE_OPENAI_MAX_RETRIES=3

# --- Azure AI Search (required when PROVIDER_MODE=azure) ---------------------
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
# Leave empty to authenticate with Entra ID.
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=procurement-evidence
AZURE_SEARCH_TIMEOUT_SECONDS=30

# Web UI
SERVE_UI=true
SAMPLES_DIR=./eval/dataset
